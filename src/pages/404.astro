---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";

const base = import.meta.env.BASE_URL.replace(/\/+$/, "");
---

<BaseLayout
  title="Page Not Found — DishSpotter"
  description="That page doesn't exist. Plan your Starlink dish placement from here instead."
  path="/404.html"
>
  <div class="not-found">
    <h1>Page not found</h1>
    <p class="lede">
      That page doesn't exist — but your placement question probably still does. Start from the
      {SITE.name} home page or open the planner.
    </p>
    <p class="cta-row">
      <a class="button" href={`${base}/`}>Go home</a>
      <a class="button button-secondary" href={`${base}/planner/`}>Open the planner</a>
    </p>
  </div>
</BaseLayout>
