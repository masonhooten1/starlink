{
  "name": "starlink",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "description": "DishSpotter — a Starlink dish placement planner (independent planning aid)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
